{
  "manifest_version": 3,
  "name": "UFC Watcher - FanDuel Capture",
  "version": "1.0.0",
  "description": "Passes the FanDuel UFC odds your open tabs already loaded to the UFC prop watcher on this PC.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://sportsbook.fanduel.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://sportsbook.fanduel.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://sportsbook.fanduel.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "UFC Watcher - FanDuel" }
}
